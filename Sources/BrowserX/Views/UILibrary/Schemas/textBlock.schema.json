{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Text Block Component",
  "description": "Rich text/markdown/code block display",
  "type": "object",
  "required": ["content", "format"],
  "properties": {
    "content": {
      "type": "string",
      "description": "Text content to display"
    },
    "format": {
      "type": "string",
      "description": "Content format type",
      "enum": ["plain", "markdown", "code"]
    },
    "language": {
      "type": "string",
      "description": "Programming language for syntax highlighting (only for format: 'code')",
      "examples": ["swift", "python", "javascript", "json"]
    },
    "copyable": {
      "type": "boolean",
      "description": "Whether to show copy button (default: true)"
    },
    "title": {
      "type": "string",
      "description": "Optional title/heading for the text block"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "content": "This is a simple text block with plain formatting.",
      "format": "plain",
      "copyable": true
    },
    {
      "content": "# Header\n\nThis is **markdown** text with _formatting_.",
      "format": "markdown",
      "title": "README"
    },
    {
      "content": "function hello() {\n  console.log('Hello, world!');\n}",
      "format": "code",
      "language": "javascript",
      "copyable": true,
      "title": "Example Function"
    }
  ]
}
