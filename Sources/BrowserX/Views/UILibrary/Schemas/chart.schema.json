{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chart Component",
  "description": "Data visualization using Swift Charts (bar, line, pie)",
  "type": "object",
  "required": ["chartType", "datasets"],
  "properties": {
    "chartType": {
      "type": "string",
      "description": "Type of chart to render",
      "enum": ["bar", "line", "pie"]
    },
    "title": {
      "type": "string",
      "description": "Optional chart title"
    },
    "labels": {
      "type": "array",
      "description": "Labels for x-axis or pie slices",
      "items": {
        "type": "string"
      }
    },
    "datasets": {
      "type": "array",
      "description": "Data series for the chart",
      "items": {
        "type": "object",
        "required": ["label", "data"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Series name"
          },
          "data": {
            "type": "array",
            "description": "Data points",
            "items": {
              "type": "number"
            }
          },
          "color": {
            "type": "string",
            "description": "Optional color (hex or named)"
          }
        }
      },
      "minItems": 1
    },
    "showLegend": {
      "type": "boolean",
      "description": "Whether to show legend (default: true)"
    }
  },
  "additionalProperties": false,
  "example": {
    "chartType": "bar",
    "title": "Commits per Week",
    "labels": ["Week 1", "Week 2", "Week 3", "Week 4"],
    "datasets": [
      {
        "label": "Commits",
        "data": [12, 19, 8, 15],
        "color": "#4A90E2"
      }
    ],
    "showLegend": true
  }
}
